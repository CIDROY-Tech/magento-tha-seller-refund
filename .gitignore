# --- Build artifacts (produced by build/bake.sh, never committed) ---
/build/artifacts/
/build/base-images.env

# --- Secrets / local env ---
/.env
**/auth.json
*.key
*.pem

# --- Magento runtime state (lives inside the baked image, not in the repo) ---
/vendor/
/generated/
/var/
/pub/static/
/pub/media/
/app/etc/env.php
/app/etc/config.php

# --- ERP stub runtime state ---
/erp-refund-stub/state/*
!/erp-refund-stub/state/.gitkeep

# --- Editor / OS noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
