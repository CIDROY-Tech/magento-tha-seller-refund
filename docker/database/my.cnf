# MariaDB tuning for the pre-baked assignment database.
# Copied into /etc/mysql/conf.d at image build. Values follow the platform's
# published MariaDB guidelines for Magento Open Source 2.4.7.

[mysqld]
# Magento's setup:db:status reports drift unless this is ON.
explicit_defaults_for_timestamp = ON

# Query planner guidance recommended for the platform.
optimizer_switch = 'rowid_filter=off'
optimizer_use_condition_selectivity = 1

# Sized for the assignment's data volume inside a 1 GB container.
innodb_buffer_pool_size = 512M
max_allowed_packet = 64M
tmp_table_size = 64M
max_heap_table_size = 64M

# Store defaults to JPY / ja_JP; utf8mb4 throughout.
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# Magento install creates triggers/functions during setup:upgrade.
log_bin_trust_function_creators = 1
