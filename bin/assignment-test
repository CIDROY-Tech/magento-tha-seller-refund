#!/usr/bin/env bash
# Run the module test suites inside the web container.
#   bin/assignment-test [unit|integration|smoke|all] [--filter X]
set -euo pipefail
export MSYS_NO_PATHCONV=1

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."
exec docker compose exec -T -u www-data web assignment-test "$@"
