            <tr data-role="line-row" data-order-item-id="<?= $block->escapeHtmlAttr($line['order_item_id']) ?>">
                <td><?= $block->escapeHtml($line['sku']) ?></td>
                <td><?= $block->escapeHtml($line['product_name']) ?></td>
                <td><?= $block->escapeHtml($line['qty_ordered']) ?></td>
                <td><?= $block->escapeHtml($line['qty_refunded_before']) ?></td>
                <td data-role="remaining"><?= $block->escapeHtml($line['qty_remaining']) ?></td>
                <td><?= $block->escapeHtml($block->formatMoney($line['unit_price'], $currency)) ?></td>
                <td><?= $block->escapeHtml($line['tax_rate']) ?></td>
                <td>
