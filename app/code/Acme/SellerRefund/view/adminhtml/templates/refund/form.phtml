$currency = $config['currency'];
?>
<div id="acme-refund-form" class="acme-refund-form">
    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($config['formKey']) ?>"/>
    <input type="hidden" data-role="order-id" name="order_id" value="<?= $block->escapeHtmlAttr($config['orderId']) ?>"/>

    <div class="admin__field">
        <label class="admin__field-label" for="acme-refund-reason"><?= $block->escapeHtml(__('Reason')) ?></label>
        <div class="admin__field-control">
            <select id="acme-refund-reason" data-role="reason" name="reason_code">
                <option value="damaged"><?= $block->escapeHtml(__('Damaged')) ?></option>
                <option value="wrong_item"><?= $block->escapeHtml(__('Wrong item')) ?></option>
                <option value="customer_request"><?= $block->escapeHtml(__('Customer request')) ?></option>
            </select>
        </div>
    </div>

    <table class="data-grid acme-refund-lines">
        <thead>
            <tr>
                <th><?= $block->escapeHtml(__('SKU')) ?></th>
                <th><?= $block->escapeHtml(__('Product')) ?></th>
                <th><?= $block->escapeHtml(__('Ordered')) ?></th>
                <th><?= $block->escapeHtml(__('Previously Refunded')) ?></th>
                <th><?= $block->escapeHtml(__('Remaining')) ?></th>
                <th><?= $block->escapeHtml(__('Unit Price')) ?></th>
                <th><?= $block->escapeHtml(__('Tax Rate')) ?></th>
                <th><?= $block->escapeHtml(__('Refund Qty')) ?></th>
                <th><?= $block->escapeHtml(__('Line Amount')) ?></th>
            </tr>
        </thead>
