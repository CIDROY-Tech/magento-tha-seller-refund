# Copy this file to .env to override any of the defaults below.
#
#   cp .env.example .env
#
# Every value already has a sensible default baked into compose.yaml, so the
# stack runs with `docker compose up` even without a .env file. Override only
# when a port is already taken on your machine.

# --- Published host ports ---------------------------------------------------
# Storefront + Admin (nginx listens on 8080 inside the container).
WEB_PORT=8080
# ERP Refund API stub (listens on 8081 inside the container).
STUB_PORT=8081
# MariaDB. Only published when you opt in to build/compose.debug.yaml; the
# application talks to the database over the internal Compose network, so you
# do not need this for normal use.
DB_PORT=33306

# --- Memory hints -----------------------------------------------------------
# The stack fits in roughly 5.2 GB. Give Docker at least 8 GB of RAM. The
# per-service limits are set in compose.yaml (web 3g, db 1g, search 1g,
# stub 128m, readiness 64m) and do not need changing here.
